{
  "name": "straatbeeld",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @straatbeeld/web",
    "build": "npm run build -w @straatbeeld/web",
    "start": "npm run start -w @straatbeeld/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @straatbeeld/web",
    "test": "tsx --test packages/contracts/tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:check": "node --env-file=apps/web/.env.local --import tsx scripts/check-supabase.ts",
    "db:seed": "node --env-file=apps/web/.env.local --import tsx scripts/seed-supabase.ts",
    "format": "prettier --write apps/web/src packages/contracts/src packages/contracts/tests scripts docs/*.md README.md AGENTS.md"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "type": "module"
}
