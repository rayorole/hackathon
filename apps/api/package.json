{
  "name": "@kbo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "ingest": "tsx --env-file-if-exists=../../.env.local src/scripts/ingest.ts",
    "enrich": "tsx --env-file-if-exists=../../.env.local src/scripts/enrich.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@kbo/core": "*",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.3.16",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
