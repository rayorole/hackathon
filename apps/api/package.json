{
  "name": "@kbo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate:ai": "tsx --env-file-if-exists=../../.env.local src/scripts/migrate-ai.ts",
    "test": "tsx --test src/ai/*.test.ts src/routes/*.test.ts",
    "ai:smoke": "tsx --env-file-if-exists=../../.env.local src/scripts/smoke-ai.ts",
    "ai:pilot": "tsx --env-file-if-exists=../../.env.local src/scripts/pilot-ai.ts",
    "ingest": "tsx --env-file-if-exists=../../.env.local src/scripts/ingest.ts",
    "enrich": "tsx --env-file-if-exists=../../.env.local src/scripts/enrich.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.67",
    "@hono/node-server": "^1.19.5",
    "@kbo/core": "*",
    "@supabase/supabase-js": "2.116.0",
    "ai": "^7.0.102",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.2",
    "ipaddr.js": "^1.9.1",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.3.16",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
