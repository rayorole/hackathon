# Works immediately without credentials. Restart Next after changing NEXT_PUBLIC_*.
NEXT_PUBLIC_DATA_MODE=fixtures
# Server backend for API mode: fixtures (read-only) or supabase.
DATA_BACKEND=fixtures
# Keep these server-only; never use NEXT_PUBLIC_ for a secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional publishable key for future authenticated browser client; unused by starter.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production API reads/writes are disabled until real authentication is implemented.
# AI integration belongs to Jochem; the starter makes no paid AI requests.
OPENAI_API_KEY=

# AI execution is centralized on Jochem’s backend; do not create another budget ledger.
# Absolute path to existing persistent ledger (initialized once with ai:init-budget).
AI_BUDGET_FILE=
